prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: manifold
Description: Geometry library for topological robustness
Version: 3.2.1
URL: https://github.com/elalish/manifold
Requires-private:  Clipper2
Libs: "-L${libdir}" -lmanifold
Cflags: "-I${includedir}" -std=c++17

