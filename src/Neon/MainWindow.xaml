<Window x:Class="Neon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Neon.Controls"
        xmlns:main="clr-namespace:Neon"
        Title="Neon"
        Width="1200"
        Height="800"
        Background="#333"
        Foreground="#DDD"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"  
                      ResizeBorderThickness="5" 
                      GlassFrameThickness="0" 
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5,10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid>
                            <Border x:Name="Border" 
                                    Background="Transparent" 
                                    BorderThickness="0"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                    <ColumnDefinition Width="15"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="1" 
                                                  ContentSource="Header" 
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="2" 
                                           Text="{TemplateBinding InputGestureText}" 
                                           Foreground="#888"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" 
                                   PopupAnimation="Fade">
                                <Border Background="#222" 
                                        BorderBrush="#444" 
                                        BorderThickness="1" 
                                        Padding="2">
                                    <StackPanel IsItemsHost="True" 
                                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#444"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#666"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="Marlett"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444"/>
                    <Setter Property="Foreground" Value="#FFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="#555">
        <Grid Background="#1E1E1E">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition x:Name="MainLogRow" Height="224" MinHeight="24" />
            </Grid.RowDefinitions>

            <!--TitleBar-->
            <Grid Grid.Row="0" Background="#333">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Neon" FontWeight="Bold" Foreground="#FFF" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="0" Style="{StaticResource CaptionButtonStyle}" Click="Min_Click"/>
                    <Button x:Name="MaxBtn" Content="1" Style="{StaticResource CaptionButtonStyle}" Click="Max_Click"/>
                    <Button Content="r" Style="{StaticResource CloseButtonStyle}" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!--MenuBar-->
            <Grid Grid.Row="1" Background="#2D2D30">
                <Menu Background="Transparent" 
                      VerticalAlignment="Center" 
                      HorizontalAlignment="Left">
                    <MenuItem Header="_File">
                        <MenuItem Header="_Open" Click="Menu_File_Open_Click" InputGestureText="Ctrl+O"/>
                        <MenuItem Header="_Exit" Click="Menu_File_Exit_Click" InputGestureText="Alt+F4"/>
                    </MenuItem>

                    <MenuItem Header="Point">
                        <MenuItem Header="Show Point Normal" Click="Menu_Point_ShowPointNormal_Click"/>
                        <MenuItem Header="Show Point Normal Deviation" Click="Menu_Point_ShowPointNormalDeviation_Click"/>
                    </MenuItem>
                    
                    <MenuItem Header="PointCloud">
                        <MenuItem Header="Clone" Click="Menu_PointCloud_Clone_Click"/>
                        <Separator/>
                        <MenuItem Header="Show Sparse Grid" Click="Menu_PointCloud_ShowSparseGrid_Click"/>
                        <MenuItem Header="Show Sparse DataBlocks" Click="Menu_PointCloud_ShowSparseDataBlocks_Click"/>
                        <MenuItem Header="Show Normals" Click="Menu_PointCloud_ShowNormals_Click"/>
                        <Separator/>
                        <MenuItem Header="Clustering" Click="Menu_PointCloud_Clustering_Click"/>
                        <MenuItem Header="SOR" Click="Menu_PointCloud_SOR_Click"/>
                        <MenuItem Header="ROR" Click="Menu_PointCloud_ROR_Click"/>
                        <MenuItem Header="Curvature Analysis" Click="Menu_PointCloud_Curvature_Analysis_Click"/>
                        <MenuItem Header="Normal Deviation Analysis" Click="Menu_PointCloud_Normal_Deviation_Analysis_Click"/>
                        <MenuItem Header="Composite Outlier Filter" Click="Menu_PointCloud_Composite_Outlier_Filter_Click"/>
                        <MenuItem Header="Node Editor" Click="Menu_PointCloud_Node_Editor_Click"/>
                    </MenuItem>

                    <MenuItem Header="VD">
                        <MenuItem Header="Clear All" Click="Menu_VD_ClearAll_Click"/>
                    </MenuItem>

                    <MenuItem Header="_View">
                        <MenuItem Header="Toggle Grid" Click="Menu_View_ToggleGrid_Click"/>
                        <MenuItem Header="Toggle Axis Gizmo" Click="Menu_View_ToggleAxisGizmo_Click"/>
                        <MenuItem Header="Toggle Center Gizmo" Click="Menu_View_ToggleCenterGizmo_Click"/>
                        <Separator/>
                        <MenuItem Header="Toggle Log" Click="Menu_View_ToggleLog_Click"/>
                        <Separator/>
                        <MenuItem Header="Reset Layout"/>
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="_About"/>
                    </MenuItem>
                </Menu>
            </Grid>

            <!--HeliumControl-->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216.01" MaxWidth="400"/>
                    <ColumnDefinition Width="33.99"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#222" BorderBrush="#333" BorderThickness="0,0,1,0" Grid.ColumnSpan="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#333" BorderThickness="0,0,0,1">
                            <TextBlock Text="Scene Explorer" 
                                       Foreground="#DDD" 
                                       FontWeight="Bold" 
                                       VerticalAlignment="Center" 
                                       Margin="10,0,0,0"/>
                        </Border>

                        <TreeView x:Name="SceneTree"
          Grid.Row="1"
          Background="Transparent"
          BorderThickness="0"
          Foreground="#DDD"
          Padding="5"
          ItemsSource="{Binding SceneItems}"
          SelectedItemChanged="SceneTree_SelectedItemChanged">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="Foreground" Value="#E1E1E1" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Margin" Value="0,1,0,1"/>

                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />

                                    <Style.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3E3E42"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>

                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3E3E42"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                                    </Style.Resources>

                                    <Style.Triggers>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="#2D2D30"/>
                                        </MultiTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>

                            <TreeView.Resources>
                                <Style TargetType="{x:Type TreeViewItem}">
                                    <Setter Property="Foreground" Value="#DDD"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Padding" Value="5,2"/>
                                    <Style.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#444"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#333"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#CCC"/>
                                    </Style.Resources>
                                </Style>
                            </TreeView.Resources>

                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type main:SceneNode}">
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                      IsChecked="{Binding IsVisible}" 
                      Click="SceneItemCheckBox_Click"
                      VerticalAlignment="Center" 
                      Margin="0,0,6,0"/>

                                        <TextBlock Grid.Column="1"
                       Text="☁" 
                       Foreground="#4CAF50" 
                       Margin="0,0,4,0" 
                       VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                       Text="{Binding Name}" 
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

                                        <Button Grid.Column="3"
                    Content="✕"
                    Click="SceneItemDelete_Click"
                    Foreground="#888"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4,0"
                    VerticalAlignment="Center"
                    Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="Red"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="2" 
                              HorizontalAlignment="Stretch" 
                              Background="#444" 
                              ResizeBehavior="PreviousAndNext"/>

                <Grid Grid.Column="3">

                    <local:HeliumHost x:Name="HeliumHostControl"/>

                    <Popup IsOpen="True"
       PlacementTarget="{Binding ElementName=HeliumHostControl}"
       Placement="Relative"
       AllowsTransparency="True"
       StaysOpen="True"
       IsHitTestVisible="False"
       Width="{Binding ActualWidth, ElementName=HeliumHostControl}"
       Height="{Binding ActualHeight, ElementName=HeliumHostControl}">

                        <Grid>

                            <Border VerticalAlignment="Top" 
                HorizontalAlignment="Left" 
                Margin="10"
                Padding="8"
                Background="#66000000"
                CornerRadius="4">

                                <TextBlock Text="{Binding HeliumStatusText}" 
                       Foreground="#00FF00" 
                       FontFamily="Consolas"
                       FontSize="12"
                       FontWeight="Bold">
                                    <TextBlock.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="2" Color="Black"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Notifications}"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Right"
                      Margin="0,0,20,20">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel VerticalAlignment="Bottom"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#99000000" 
                            CornerRadius="5" 
                            Margin="0,5,0,0" 
                            Padding="15,10">

                                            <TextBlock Text="{Binding Text}" 
                                   Foreground="#FFCC00" 
                                   FontWeight="SemiBold" 
                                   FontSize="14">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect ShadowDepth="0" BlurRadius="2" Color="Black"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </Grid>
                    </Popup>
                </Grid>
            </Grid>

            <GridSplitter Grid.Row="3" 
                          Height="5" 
                          HorizontalAlignment="Stretch" 
                          VerticalAlignment="Center"
                          Background="#444"
                          ResizeBehavior="PreviousAndNext"/>

            <!--LogPanel-->
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#222" BorderBrush="#333" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <ToggleButton x:Name="LogToggle"
              Grid.Column="0"
              Content="Log"
              IsChecked="True"
              Checked="LogToggle_Checked"    
              Unchecked="LogToggle_Unchecked"
              Click="LogToggle_Click" 
              Background="Transparent"
              Foreground="#AAA"
              BorderThickness="0"
              HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#111" BorderBrush="#333" BorderThickness="1">
                    <ListBox x:Name="LogList"
                             Background="#111"
                             Foreground="#0F0"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="12"
                             KeyDown="LogList_KeyDown"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.ScrollChanged="LogList_ScrollChanged"
                             SelectionMode="Extended"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}"
                                           Foreground="{Binding Foreground}"
                                           TextWrapping="NoWrap"
                                           IsHitTestVisible="False"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>