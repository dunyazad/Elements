<Window x:Class="Neon.CompositeOutlierFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Composite Outlier Filter" 
        Width="350" SizeToContent="Height"
        WindowStartupLocation="Manual" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="#E1E1E1" WindowStyle="ToolWindow">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E1E1E1"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E1E1E1"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0097FB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Border Padding="20">
        <StackPanel>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Select Criteria to Combine"/>
                <Border Background="#2D2D30" CornerRadius="3" Padding="10">
                    <StackPanel>
                        <CheckBox x:Name="CheckSOR" Content="Statistical Outlier (SOR)" IsChecked="True"/>
                        <CheckBox x:Name="CheckROR" Content="Radius Outlier (ROR)" IsChecked="True"/>
                        <CheckBox x:Name="CheckCurvature" Content="Curvature Threshold" IsChecked="False"/>
                        <CheckBox x:Name="CheckNormalDev" Content="Normal Deviation Threshold" IsChecked="False"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Combination Logic"/>
                <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                    <RadioButton x:Name="RadioUnion" Content="Union (OR)" IsChecked="True" 
                                 ToolTip="Mark as outlier if ANY selected criteria is met."/>
                    <RadioButton x:Name="RadioIntersect" Content="Intersection (AND)" 
                                 ToolTip="Mark as outlier only if ALL selected criteria are met."/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Preview (Red)" Width="100" Height="30" Click="Preview_Click" Margin="0,0,10,0"
                        ToolTip="Visualize combined outliers in Red without deleting."/>
                <Button Content="Delete Outliers" Width="110" Height="30" Click="Apply_Click" Style="{StaticResource AccentButtonStyle}"
                        ToolTip="Remove points matching the combined criteria."/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>