<Window x:Class="Neon.RorParameterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROR Parameters" Height="220" Width="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Search Radius:" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtRadius" Text="0.5" Margin="0,0,0,10" Padding="2"/>

            <TextBlock Text="Min Neighbors in Radius:" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtMinNeighborsInRadius" Text="84" Margin="0,0,0,20" Padding="2"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Width="80" Height="25" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="Apply" IsDefault="True" Width="80" Height="25" Click="Apply_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
    