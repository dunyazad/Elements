<Window x:Class="Neon.Controls.CompositeFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Composite Filter Manager" Height="450" Width="600"
        Background="#2D2D30" Foreground="#DDD"
        WindowStartupLocation="CenterOwner">

	<Window.Resources>
		<Style TargetType="Button">
			<Setter Property="Background" Value="#444"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Margin" Value="0,0,0,5"/>
			<Setter Property="Padding" Value="10,5"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#555"/>
				</Trigger>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Background" Value="#333"/>
					<Setter Property="Foreground" Value="#666"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<Grid Margin="10">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="60"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.Row="0" BorderBrush="#444" BorderThickness="1" Background="#1E1E1E">
            <ListBox ItemsSource="{Binding Steps}"
             SelectedItem="{Binding SelectedStep}"
             Background="Transparent"
             BorderThickness="0"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding OperationTypes}"
                      SelectedItem="{Binding SelectedOperation}"
                      Height="26"
                      VerticalContentAlignment="Center"
                      Margin="0,0,5,0"
                      ToolTip="Boolean Operation"/>

                            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding FilterTypes}"
                      SelectedItem="{Binding SelectedType}"
                      Height="26"
                      VerticalContentAlignment="Center"
                      ToolTip="Filter Algorithm"/>

                            <Button Grid.Column="2"
                    Command="{Binding ConfigureCommand}"
                    ToolTip="Configure Parameters"
                    Width="28" 
                    Height="26"
                    Margin="4,0,0,0"
                    Padding="0" 
                    Background="#333"
                    BorderBrush="#555"
                    BorderThickness="1">

                                <Path Data="M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.95 19.05,5.02L16.56,6.02C16.04,5.62 15.48,5.29 14.88,5.04L14.5,2.38C14.46,2.14 14.25,1.96 14,1.96L10,1.96C9.75,1.96 9.54,2.14 9.5,2.38L9.12,5.04C8.52,5.29 7.96,5.62 7.44,6.02L4.95,5.02C4.73,4.95 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.66 4.5,12C4.5,12.34 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.05 4.95,18.98L7.44,17.98C7.96,18.38 8.52,18.71 9.12,18.96L9.5,21.62C9.54,21.86 9.75,22.04 10,22.04L14,22.04C14.25,22.04 14.46,21.86 14.5,21.62L14.88,18.96C15.48,18.71 16.04,18.38 16.56,17.98L19.05,18.98C19.27,19.05 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98M12,15.5C10.07,15.5 8.5,13.93 8.5,12C8.5,10.07 10.07,8.5 12,8.5C13.93,8.5 15.5,10.07 15.5,12C15.5,13.93 13.93,15.5 12,15.5Z"
                      Fill="#CCC"
                      Stretch="Uniform"
                      Width="14"
                      Height="14"/>
                            </Button>

                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Column="1" Grid.Row="0" Margin="10,0,0,0">
			<Button Command="{Binding AddCommand}" Content="+" FontSize="16" ToolTip="Add Step"/>
			<Button Command="{Binding RemoveCommand}" Content="-" FontSize="16" ToolTip="Remove Step"/>
			<Separator Background="Transparent" Height="10"/>
			<Button Command="{Binding MoveUpCommand}" Content="▲" ToolTip="Move Up"/>
			<Button Command="{Binding MoveDownCommand}" Content="▼" ToolTip="Move Down"/>
		</StackPanel>

		<StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
			<Button Content="Apply Pipeline" Width="100" Height="30" Click="Apply_Click" Background="#007ACC"/>
			<Button Content="Cancel" Width="80" Height="30" Click="Cancel_Click" Margin="10,0,0,0"/>
		</StackPanel>
	</Grid>
</Window>